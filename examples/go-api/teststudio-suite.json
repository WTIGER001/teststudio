{
  "schemaVersion": 1,
  "suiteId": "go-api",
  "type": "api",
  "runner": "go",
  "applications": [],
  "moduleRoot": ".",
  "tests": { "packages": ["./checks"] },
  "catalog": "catalog.json",
  "buildProfile": "go-environment",
  "browser": {
    "endpoint": "api",

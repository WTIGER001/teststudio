{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teststudio:suite:v1",
  "title": "TestStudio prepared suite manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "suiteId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "type": {
      "enum": [
        "unit",
        "integration",
        "api",
        "browser",
        "accessibility",
        "visual",
        "performance"
      ]
    },
    "runner": {
      "enum": [
        "go",
        "playwright"
      ]
    },
    "applications": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "uniqueItems": true
    },
    "moduleRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "packages": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "maxLength": 512
          },
          "maxItems": 100,
          "uniqueItems": true
        },
        "project": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            {
              "const": ""
            }
          ]
        },
        "config": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
            },
            {
              "const": ""
            }
          ]
        }
      }
    },
    "catalog": {
      "allOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
        },
        {
          "pattern": "\\.(json|yaml|yml)$"
        }
      ]
    },
    "requestPolicy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f]+$"
    },
    "requiredBindings": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "uniqueItems": true
    },
    "buildProfile": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "requests": {
          "$ref": "#/$defs/APIRequestPolicy"
        }
      },
      "required": [
        "endpoint"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "suiteId",
    "type",
    "runner",
    "applications",
    "moduleRoot",
    "tests",
    "catalog",
    "buildProfile"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "runner": {
            "const": "go"
          }
        }
      },
      "then": {
        "properties": {
          "type": {
            "enum": [
              "unit",
              "integration",
              "api"
            ]
          },
          "tests": {
            "required": [
              "packages"
            ],
            "properties": {
              "packages": {
                "type": "array",
                "minItems": 1
              },
              "project": {
                "const": ""
              },
              "config": {
                "const": ""
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "type": {
            "enum": [
              "browser",
              "api",
              "accessibility",
              "visual",
              "performance"
            ]
          },
          "tests": {
            "properties": {
              "packages": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "buildProfile": {
            "const": "playwright-environment"
          }
        }
      },
      "then": {
        "required": [
          "browser"
        ],
        "properties": {
          "runner": {
            "const": "playwright"
          },
          "requiredBindings": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "requestPolicy"
          ]
        }
      },
      "else": {
        "not": {
          "required": [
            "browser"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "browser": {
            "required": [
              "requests"
            ]
          }
        },
        "required": [
          "browser"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "api"
          }
        }
      }
    }
  ],
  "$defs": {
    "APIRequestRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "HEAD",
            "OPTIONS",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ]
        },
        "pathPrefix": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^/",
          "description": "Canonical path prefix without encoded separators, dot segments, repeated separators, or trailing slash except root."
        },
        "readOnly": {
          "type": "boolean",
          "default": false
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576,
          "default": 0
        }
      },
      "required": [
        "method",
        "pathPrefix"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "GET",
                  "HEAD",
                  "OPTIONS"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "maxBodyBytes": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "PUT",
                  "PATCH",
                  "DELETE"
                ]
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "readOnly": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "APIRequestPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/APIRequestRule"
          }
        },
        "maxRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxResponseBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "redactFields": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
          }
        },
        "authentication": {
          "$ref": "#/$defs/APIAuthentication"
        }
      },
      "required": [
        "rules",
        "maxRequests",
        "maxResponseBytes"
      ]
    },
    "APIAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "binding": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "scheme": {
          "type": "string",
          "enum": [
            "bearer",
            "basic",
            "header"
          ]
        },
        "header": {
          "type": "string",
          "pattern": "^[Xx]-[A-Za-z0-9][A-Za-z0-9-]{0,61}$|^[Aa][Pp][Ii]-[Kk][Ee][Yy]$"
        }
      },
      "required": [
        "binding",
        "scheme"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "scheme": {
                "const": "header"
              }
            },
            "required": [
              "scheme"
            ]
          },
          "then": {
            "required": [
              "header"
            ]
          },
          "else": {
            "not": {
              "required": [
                "header"
              ]
            }
          }
        }
      ]
    }
  }
}

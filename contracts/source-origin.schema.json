{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:teststudio:source-origin:v1",
  "title": "TestStudio prepared source provenance",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repository": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://[^/?#@]+/[^?#]+$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "commit": {
      "type": "string",
      "pattern": "^([a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "snapshotDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "oneOf": [
    {
      "required": [
        "repository",
        "reference",
        "commit"
      ]
    },
    {
      "required": [
        "snapshotDigest"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "repository"
            ]
          },
          {
            "required": [
              "reference"
            ]
          },
          {
            "required": [
              "commit"
            ]
          }
        ]
      }
    }
  ]
}

{
  "name": "teststudio-web",
  "version": "0.14.0-dev",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200 --proxy-config proxy.json",
    "build": "ng build",
    "check": "tsc --noEmit",
    "postbuild": "node ../scripts/build-trace-viewer.mjs",
    "prebuild": "node ../scripts/build-info.mjs",
    "prestart": "node ../scripts/build-info.mjs",
    "precheck": "node ../scripts/build-info.mjs",
    "build:status": "ng-packagr -p projects/status/ng-package.json -c projects/status/tsconfig.lib.json"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
